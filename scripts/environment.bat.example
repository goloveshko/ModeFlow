@echo off
rem ============================================================================
rem ModeFlow – Local Environment Configuration Template
rem Copy this file to "environment.bat" in the scripts/ folder to override
rem local developer tool paths and test server URLs without modifying build.bat.
rem
rem Note: "environment.bat" is listed in .gitignore and will not be committed.
rem Always use forward slashes (/) when setting local file paths or URLs.
rem ============================================================================

rem --- Local Developer Toolchain Paths ---
rem set "QT_DIR=C:\Qt\6.11.1\msvc2022_64"
rem set "VS_PATH=C:\Program Files\Microsoft Visual Studio\18\Community\VC"
rem set "VCPKG_EXE=C:\dev\vcpkg\vcpkg.exe"

rem --- Local Forgejo / Development Test Server Overrides ---
rem set "SITE_URL=http://localhost:3000/goloveshko"
rem set "UPDATE_URL=http://localhost:3000/goloveshko/ModeFlow/raw/branch/main/metadata/update.json"
rem set "LICENSE_URL=http://localhost:3000/goloveshko/ModeFlow/src/branch/main/LICENSE"
rem set "GIT_HOST_URL=http://localhost:3000/goloveshko/ModeFlow"
