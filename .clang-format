BasedOnStyle: LLVM

# Base formatting rules
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: -4
UseTab: Never
ColumnLimit: 120

# C++ Standard
Standard: Latest # Support for C++20 features

# Include sorting logic
SortIncludes: true
IncludeBlocks: Regroup

# Automatically detect main header (e.g., Foo.h for Foo.cpp)
IncludeIsMainRegex: '([-_](test|unittest))?$'

IncludeCategories:
  # 1. Main header (Implicit priority 0)

  # 2. Qt UI files (generated headers)
  - Regex: '^"ui_.*\.h"'
    Priority: 1

  # 3. STL and System headers
  - Regex: '^<.*>'
    Priority: 2

  # 4. Qt Framework headers
  - Regex: '^<(Qt.*|Q.*)>'
    Priority: 3

  # 5. Third-party libraries (e.g., Audio library)
  - Regex: '^<(boost|fmt|spdlog|FredEmmott)/.*>'
    Priority: 4

  # 6. Local project headers
  - Regex: '^".*"'
    Priority: 5

# Function and statement formatting
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
PointerAlignment: Left
BreakBeforeBraces: Attach
NamespaceIndentation: None
FixNamespaceComments: true

# Advanced UI/Qt formatting
AlignAfterOpenBracket: Align
AlwaysBreakTemplateDeclarations: Yes