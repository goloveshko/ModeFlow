/* ============================================================
   ModeFlow – Dark Theme
   Fluent Design for Windows 11
   ============================================================ */

/* ── Theme Palette Guide ───────────────────────────────────
   Base text:                #e0e0e0
   Muted text:               #aaaaaa
   Regular icons:            rgba(214, 222, 228, 0.84)
   Active icon tint:         rgba(149, 189, 202, 0.96)
   Primary accent:           #6ca8ba
   Primary accent hover:     #7ab6c8
   Primary accent pressed:   #5a93a4
   Soft accent background:   rgba(108, 168, 186, 0.16)
   Disabled icon/text:       rgba(255, 255, 255, 0.4)

   Recommended usage:
   - New regular icons: use regular icons, not the accent, to avoid visual noise.
   - Active/important icons: use primary accent.
   - Hovered active icons: use primary accent hover.
   - Pressed active icons: use primary accent pressed.
   - Disabled icons: use disabled icon/text.
   - Selected backgrounds and focus accents: use primary accent or soft accent background.
*/

/* ── Window & Dialogs ────────────────────────────────────── */
QDialog {
    background-color: rgb(28, 28, 28);
}

/* ── Widget base ─────────────────────────────────────────── */
QWidget {
    background-color: transparent;
    color: #e0e0e0;
}

/* ── Tab Widget ──────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: #252525;
    border-radius: 8px;
}

QTabBar::tab {
    color: rgba(255, 255, 255, 0.55);
}

QTabBar::tab:selected {
    color: #e0e0e0;
    border-bottom: 2px solid #6ca8ba;
}

QTabBar::tab:hover:!selected {
    background: rgba(32, 32, 32, 0.8);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 4px 4px 0 0;
}

/* ── Push Button ─────────────────────────────────────────── */
QPushButton {
    background-color: rgba(32, 32, 32, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    color: #e0e0e0;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.2);
}

QPushButton:focus {
    border-color: rgba(108, 168, 186, 0.34);
    border-bottom-color: rgba(108, 168, 186, 0.55);
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(32, 32, 32, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.28);
}

/* ── Primary Push Button (Dark Theme) ────────────────────── */
QPushButton:default {
    background-color: #6ca8ba; /* Solid Fluent Accent for Dark Theme */
    border: 1px solid #6ca8ba;
    color: #0d1e21; /* High-contrast dark text on light-blue background */
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #7ab6c8;
    border-color: #7ab6c8;
    color: #0d1e21;
}

QPushButton:default:pressed {
    background-color: #5a93a4;
    border-color: #5a93a4;
    color: #0d1e21;
}

QPushButton:default:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.28);
}

/* ── Tool Button (icon-only buttons: settings, about) ────── */
QToolButton {
    margin: 2px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
}

QToolButton:focus {
    background-color: rgba(108, 168, 186, 0.14);
    border: 1px solid rgba(108, 168, 186, 0.5);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.03);
}

/* ── Line Edit ───────────────────────────────────────────── */
QLineEdit,
QTextEdit {
    background-color: rgba(0, 0, 0, 0.2);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    selection-background-color: #6ca8ba;
    selection-color: #08151a;
}

QLineEdit:hover,
QTextEdit:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QLineEdit:focus,
QTextEdit:focus {
    border-color: #6ca8ba;
    background-color: rgba(0, 0, 0, 0.25);
}

QLineEdit:read-only,
QTextEdit:read-only {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
}

QLineEdit:disabled,
QTextEdit:disabled {
    color: rgba(255, 255, 255, 0.28);
    background-color: rgba(255, 255, 255, 0.03);
}

/* ── Key Sequence Edit ───────────────────────────────────── */
QKeySequenceEdit {
    background-color: rgba(0, 0, 0, 0.2);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    selection-background-color: #6ca8ba;
    selection-color: #08151a;
}

QKeySequenceEdit:focus {
    border-color: #6ca8ba;
}

/* ── Spin Box ────────────────────────────────────────────── */
QSpinBox {
    background-color: rgba(0, 0, 0, 0.2);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    selection-background-color: #6ca8ba;
    selection-color: #08151a;
}

QSpinBox:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QSpinBox:focus {
    border-color: #6ca8ba;
}

QSpinBox:disabled {
    color: rgba(255, 255, 255, 0.28);
    background-color: rgba(255, 255, 255, 0.03);
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QSpinBox::up-arrow {
    border-bottom: 5px solid rgba(255, 255, 255, 0.65);
}

QSpinBox::down-arrow {
    border-top: 5px solid rgba(255, 255, 255, 0.65);
}

QSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled {
    border-bottom-color: rgba(255, 255, 255, 0.22);
    border-top-color: rgba(255, 255, 255, 0.22);
}

/* ── Combo Box ───────────────────────────────────────────── */
QComboBox {
    background-color: rgba(32, 32, 32, 0.8);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QComboBox:focus {
    border-color: #6ca8ba;
}

QComboBox:disabled {
    color: rgba(255, 255, 255, 0.28);
    background-color: rgba(255, 255, 255, 0.03);
}

QComboBox::down-arrow {
    border-top: 5px solid rgba(255, 255, 255, 0.65);
}

QComboBox::down-arrow:disabled {
    border-top-color: rgba(255, 255, 255, 0.22);
}

QComboBox QAbstractItemView {
    background-color: rgba(32, 32, 32, 0.85);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    selection-background-color: rgba(108, 168, 186, 0.2);
    selection-color: #e7f1f4;
}

QComboBox QAbstractItemView::item:hover {

    background-color: rgba(255, 255, 255, 0.07);
}

QComboBox QAbstractItemView::item:selected {
    background-color: rgba(108, 168, 186, 0.2);
    color: #e7f1f4;
}

/* ── List View ───────────────────────────────────────────── */
QListView {
    background-color: rgba(0, 0, 0, 0.15);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 10px;
}

QListWidget {
    background-color: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

QListWidget::item {
    color: #aaaaaa;
    padding: 4px 8px;
}

QListWidget::item:selected {
    background-color: rgba(108, 168, 186, 0.16);
    color: #eef4f6;
}

QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.07);
}

/* ── Check Box ───────────────────────────────────────────── */
QCheckBox {
    color: #e8e8e8;
}

QCheckBox::indicator {
    border: 1px solid #697381;
    background-color: rgba(255, 255, 255, 0.07);
}

QCheckBox::indicator:hover {
    border: 1px solid #6ca8ba;
    background-color: #24353c;
}

QCheckBox::indicator:pressed {
    border: 1px solid #5a93a4;
    background-color: #2b4048;
}

QCheckBox::indicator:checked {
    border: 1px solid #6ca8ba;
    background-color: #6ca8ba;
}

QCheckBox::indicator:checked:hover {
    border: 1px solid #7ab6c8;
    background-color: #7ab6c8;
}

QCheckBox::indicator:checked:pressed {
    border: 1px solid #5a93a4;
    background-color: #5a93a4;
}

QCheckBox::indicator:disabled {
    border: 1px solid #4e5561;
    background-color: #2a2f37;
}

QCheckBox::indicator:checked:disabled {
    border: 1px solid #5e6878;
    background-color: #5e6878;
}

/* ── Label ───────────────────────────────────────────────── */
QLabel {
    color: #e0e0e0;
}

/* ── Group Box (Fluent Cards for Dark Theme) ─────────────── */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.03); /* Soft translucent card background on top of Mica */
    border: 1px solid rgba(255, 255, 255, 0.08); /* Low-contrast Fluent border */
    border-radius: 8px;
    margin-top: 24px; /* Leaves perfect whitespace for the section header to sit above */
    padding: 12px 12px 12px 12px; /* Generous padding inside the card container */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    top: 4px; /* Positions the text cleanly above the card's top border */
    font-weight: 600;
    font-size: 9.5pt;
    color: rgba(255, 255, 255, 0.9);
}

/* ── Frame separators ────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.1);
}

/* ── Scroll Bar ──────────────────────────────────────────── */
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.18);
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.38);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(255, 255, 255, 0.55);
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.18);
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.38);
}

QScrollBar::handle:horizontal:pressed {
    background: rgba(255, 255, 255, 0.55);
}

/* ── Plain Text Edit ─────────────────────────────────────── */
QPlainTextEdit {
    background-color: rgba(0, 0, 0, 0.3);
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    selection-background-color: #6ca8ba;
    selection-color: #08151a;
}

QPlainTextEdit:focus {
    border-color: rgba(108, 168, 186, 0.68);
}

/* ── Menu ────────────────────────────────────────────────── */
QMenu {
    background-color: #2c2c2c;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QMenu::item {
    color: #e0e0e0;
}

QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

QMenu::item:disabled {
    color: rgba(255, 255, 255, 0.4);
}

QMenu::item:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QMenu::separator {
    background: rgba(255, 255, 255, 0.1);
}

QMenu#profileIconMenu,
QMenu#moreMenu {
    background-color: rgba(30, 30, 30, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QToolButton#profileIconOption {
    background-color: transparent;
    border: 1px solid transparent;
}

QToolButton#profileIconOption:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QToolButton#profileIconOption:pressed {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QToolButton#profileIconOption[selected="true"] {
    background-color: rgba(108, 168, 186, 0.16);
    border: 1px solid rgba(108, 168, 186, 0.42);
}

/* ── Tool Tip ────────────────────────────────────────────── */
QToolTip {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QSizeGrip {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QSizeGrip:hover {
    background-color: rgba(108, 168, 186, 0.16);
    border: 1px solid rgba(108, 168, 186, 0.34);
}

QSizeGrip:pressed {
    background-color: rgba(108, 168, 186, 0.24);
    border: 1px solid rgba(108, 168, 186, 0.46);
}

/* ── Status Bar ──────────────────────────────────────────── */
QStatusBar {
    background-color: #1c1c1c;
    color: rgba(255, 255, 255, 0.5);
    border-top: 1px solid rgba(32, 32, 32, 0.8);
}

#AboutDialog QLabel#labelIcon {
    image: url(:/icons/dark/icon.svg);
}

/* About Dialog */
#AboutDialog QLabel#labelTitle {
    color: #ffffff;
}

#AboutDialog QLabel#labelVersion,
#AboutDialog QLabel#labelDescription {
    color: rgba(255, 255, 255, 0.7);
}

#AboutDialog QLabel#labelDisclaimer {
    color: rgba(255, 255, 255, 0.4);
}

/* Links */
#WorkspaceWindow QPushButton#btnCapture,
#AboutDialog QPushButton#btnGithub,
#AboutDialog QPushButton#btnNewVersion,
#AboutDialog QPushButton#btnLicenses {
    color: rgba(149, 189, 202, 0.88);
}

#WorkspaceWindow QPushButton#btnCapture:hover,
#AboutDialog QPushButton#btnGithub:hover,
#AboutDialog QPushButton#btnNewVersion:hover,
#AboutDialog QPushButton#btnLicenses:hover {
    color: rgba(180, 210, 220, 0.96);
}

#styleBridge {
    qproperty-iconprefix: ":/icons/dark";
    qproperty-iconnormal: rgba(214, 222, 228, 0.84);
    qproperty-iconactive: rgba(149, 189, 202, 0.96);
    qproperty-icondisabled: rgba(255, 255, 255, 0.4);

    qproperty-sidebaritemhoverbg: rgba(255, 255, 255, 0.07);
    qproperty-sidebaritemselectedbg: rgba(108, 168, 186, 0.16);
    qproperty-sidebartextnormal: #aaaaaa;
    qproperty-sidebartextselected: #eef4f6;
    qproperty-sidebaraccent: #6ca8ba;

    /* LogViewer colors */
    qproperty-logtimestamp: #808080;
    qproperty-logcategory: #64B4FF;
    qproperty-logfunction: #B4B464;
    qproperty-logdebug: #888888;
    qproperty-loginfo: #4CAF50;
    qproperty-logwarning: #FF9800;
    qproperty-logcritical: #F44336;
    qproperty-logfatal: #B71C1C;
}

QMessageBox {
    background-color: rgba(30, 30, 30, 0.9);
}

QToolButton#btnAdd:hover,
QToolButton#btnRemove:hover,
QToolButton#btnSettings:hover,
QToolButton#btnAbout:hover,
QToolButton#btnProfileIcon:hover,
QToolButton#btnBrowse:hover {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
}

QToolButton#btnAdd:focus,
QToolButton#btnRemove:focus,
QToolButton#btnSettings:focus,
QToolButton#btnAbout:focus,
QToolButton#btnProfileIcon:focus,
QToolButton#btnBrowse:focus {
    background: rgba(108, 168, 186, 0.14);
    border: 1px solid rgba(108, 168, 186, 0.5);
    border-radius: 6px;
}

QToolButton#btnProfileIcon,
QToolButton#btnBrowse {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

#WorkspaceWindow QToolButton#btnUpdate {
    color: rgba(149, 189, 202, 0.96);
}

QWidget#profileRowWidget QToolButton#btnDeleteProfileInline,
QWidget#appRowWidget QToolButton#btnDeleteAppInline {
    border: 1px solid rgba(255, 255, 255, 0.08); /* Very soft low-contrast outline */
    background-color: rgba(255, 255, 255, 0.02); /* Translucent resting fill */
    border-radius: 4px;
    padding: 0;
    margin: 0;
}

QWidget#profileRowWidget QToolButton#btnDeleteProfileInline:hover,
QWidget#appRowWidget QToolButton#btnDeleteAppInline:hover {
	background-color: rgba(244, 67, 54, 0.18); /* Soft warnings-red fill */
    border: 1px solid rgba(244, 67, 54, 0.35);  /* Red outline */
}

QWidget#appRowWidget QLabel#appAddIconLabel,
QWidget#appRowWidget QLabel#appAddTextLabel {
    color: rgba(255, 255, 255, 0.4);
}

QWidget#appRowWidget:hover QLabel#profileIconLabel,
QWidget#appRowWidget:hover QLabel#appAddTextLabel {
    color: #6ca8ba;
}

#WorkspaceWindow QPushButton#btnCreateProfile {
    background-color: rgba(0, 0, 0, 0.15);
    color: rgba(255, 255, 255, 0.5);
    
    border-right: 1px solid rgba(255, 255, 255, 0.05); 
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

#WorkspaceWindow QPushButton#btnCreateProfile:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #eef4f6;
}

/* ── Log Viewer Active Auto-scroll Button (Dark Theme) ───── */
QToolButton#btnFollow:checked {
    background-color: rgba(108, 168, 186, 0.16); /* Soft biqyuoise theme accent */
    border: 1px solid rgba(108, 168, 186, 0.34);
}

/* ── File Dialog (DontUseNativeDialog Styling) ───────────── */
QFileDialog {
    background-color: rgb(28, 28, 28);
}

/* Beautiful dark translucent file grid containers on top of Mica */
QFileDialog QTreeView,
QFileDialog QListView {
    background-color: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #e0e0e0;
}

/* ── File Dialog Dropdowns (Dark Theme Contrast Fix) ─────── */
QFileDialog QAbstractItemView,
QFileDialog QComboBox QAbstractItemView {
    background-color: #2c2c2c !important;
    color: #e0e0e0 !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
}

QFileDialog QAbstractItemView::item:selected {
    background-color: rgba(108, 168, 186, 0.2) !important;
    color: #e7f1f4 !important;
}
