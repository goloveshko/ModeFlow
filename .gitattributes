# Enforce CRLF line endings for Windows batch files
# cmd.exe cannot find labels (call :subroutine) in files with LF endings
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.rc    text eol=crlf

# Source files — LF everywhere
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.qrc   text eol=lf
*.ui    text eol=lf
*.ts    text eol=lf
*.qm    binary

# Git & Tool configs
.gitignore     text eol=lf
.gitattributes text eol=lf
.clang-format  text eol=lf
.clangd        text eol=lf

# Binary files
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.svg   binary
*.exe   binary
*.dll   binary
*.lib   binary